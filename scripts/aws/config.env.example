# Copy to scripts/aws/.env and edit. scripts/aws/.env is gitignored.

AWS_REGION=us-east-1
INSTANCE_TYPE=g4dn.xlarge
VOLUME_GB=100
NAME=hapi-gpu

# Optional. Leave empty to auto-pick the newest Ubuntu PyTorch GPU Deep Learning AMI.
AMI_ID=

# Optional. Defaults to ~/.ssh/hapi-aws-<region>.pem
KEY_PATH=

# Optional SSH ingress. Empty = this computer's public IPv4 /32.
SSH_CIDR=

# Optional. If 1, request a G/VT On-Demand vCPU quota of at least 4 when it is 0.
REQUEST_GPU_QUOTA=1

# Monthly AWS budget alert in USD (fails open if Budgets is not allowed).
BUDGET_LIMIT=25
