# Copy to scripts/aws/.env and edit. scripts/aws/.env is gitignored.

AWS_REGION=us-east-1

# Runtime mode (also accepted as the first argument to 01/02/09):
#   cheap      1x g4dn.xlarge (T4) — lowest $/hour, sequential
#   parallel9  9x g5.xlarge (A10G) — fastest wall-clock
#   single8    1x g5.48xlarge (8x A10G) — one machine, 8 workers
MODE=cheap

# Suite started by 09_run_suite.sh: full | screen | confirm
SUITE=full

# Optional. Only used by MODE=single8. Use p4d.24xlarge for 8x A100 if quota allows.
SINGLE8_INSTANCE_TYPE=g5.48xlarge

VOLUME_GB=100
NAME=hapi-gpu

# Optional. Leave empty to auto-pick the newest Ubuntu PyTorch GPU Deep Learning AMI.
AMI_ID=

# Optional. Defaults to ~/.ssh/hapi-aws-<region>.pem
KEY_PATH=

# Optional SSH ingress. Empty = this computer's public IPv4 /32.
SSH_CIDR=

# If 1, request G/VT On-Demand vCPUs up to what MODE needs (4 / 40 / 192).
REQUEST_GPU_QUOTA=1

# Monthly AWS budget alert in USD (fails open if Budgets is not allowed).
# Raise this before parallel9/single8 (those can be hundreds of dollars).
BUDGET_LIMIT=25
